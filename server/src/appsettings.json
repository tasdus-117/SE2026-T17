{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=arena_game;Username=postgres;Password=postgres"
  },
  "GameSettings": {
    "MaxPlayersPerArena": 4,
    "MatchDurationSeconds": 600,
    "LobbyTimeoutSeconds": 30,
    "ReconnectTimeoutSeconds": 60,
    "TickRate": 60
  },
  "Networking": {
    "HeartbeatIntervalMs": 1000,
    "MaxLatencyMs": 500,
    "SimulateLatency": false,
    "SimulatedLatencyMs": 50
  },
  "Endpoints": {
    "Http": "http://localhost:5000",
    "Https": "https://localhost:5001"
  },
  "AllowedHosts": "*"
}
